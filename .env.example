# ---------- Required ----------
# Postgres connection string. On Render use the "Internal Database URL" of your Render Postgres.
DATABASE_URL="postgresql://user:password@host:5432/gbaanjo"
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
# Your website address(es), comma separated, NO trailing slash. The FIRST one is where Paystack sends buyers back after paying.
FRONTEND_URL="https://www.gbaanjo.com,https://gbaanjo.com,http://localhost:5173"
PORT=3000

# ---------- Payments (Paystack) ----------
# sk_test_... = test payments (no real money). sk_live_... = real money. Empty = payments are simulated locally.
PAYSTACK_SECRET_KEY=""
# TEST BOX ONLY: "true" skips seller subaccounts so test payments work without real bank details. Remove for a real launch.
PAYSTACK_NO_SPLIT=""
# "account" = GbaanJo pays Paystack's processing fee, "subaccount" = the seller pays it
PAYSTACK_BEARER="account"
# Only if you run in production WITHOUT a Paystack key (fake payments). Not needed when you have a key.
ALLOW_SIMULATED_PAYMENTS=""

# TEST VERSION ONLY: "true" adds demo sellers and listings at startup so testers have something to browse. Needs PAYSTACK_NO_SPLIT=true to pay for them.
SEED_DEMO=""

# ---------- Accounts and email ----------
# Creates your admin account when the server starts. Delete ADMIN_PASSWORD after the first successful start.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# TEMPORARY, for test versions only: "true" marks new users as verified without an email. Remove for a real launch.
SKIP_EMAIL_VERIFICATION=""
RESEND_API_KEY=""
MAIL_FROM="GbaanJo <no-reply@gbaanjo.com>"

# ---------- Food photos (Cloudinary), optional ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
