# ---------- Required ----------
# Postgres connection string (Neon works well). Use a SEPARATE database for production.
DATABASE_URL="postgresql://user:password@host:5432/chopnow?sslmode=require"
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
# Your frontend URL(s), comma separated, NO trailing slash. Local: http://localhost:5173  Live: your Vercel URL
FRONTEND_URL="http://localhost:5173"
PORT=3000

# ---------- Payments (Paystack) ----------
# Empty = local test mode (payments are simulated). Use sk_test_... for test payments, sk_live_... for real money.
PAYSTACK_SECRET_KEY=""
# "account" = ChopNow pays Paystack's processing fee, "subaccount" = the seller pays it
PAYSTACK_BEARER="account"
# TEMPORARY, for test versions only: "true" lets the server run in production WITHOUT a Paystack key (payments are simulated, no real money). Remove for a real launch.
ALLOW_SIMULATED_PAYMENTS=""

# ---------- Email (Resend) ----------
# Empty = verification links are only printed in the server log
RESEND_API_KEY=""
MAIL_FROM="ChopNow <no-reply@yourdomain.com>"
# TEMPORARY, for test versions only: "true" marks new users as verified without an email. Remove for a real launch.
SKIP_EMAIL_VERIFICATION=""

# ---------- Food photos (Cloudinary), optional ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
