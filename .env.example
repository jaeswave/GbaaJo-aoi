# Copy to .env for local work. On Render, add each of these under Environment. NEVER commit the real .env file.

# ---- Database (Supabase) ----
# Use the "Session pooler" connection string (Supabase > Connect). It works from Render, which cannot use the direct IPv6 address.
# Put the SAME string in both. If your password has symbols, encode them (@ becomes %40).
DATABASE_URL="postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Server ----
NODE_ENV=production
NODE_VERSION=22
JWT_SECRET=                       # 32+ random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Your website address(es), comma separated. The first one without a * is used in email links and payment redirects.
# A * matches any text, so one entry can cover all your Vercel preview links.
FRONTEND_URL=https://www.gbaanjo.com,https://gbaanjo.com,https://chop-*-jaeswaves-projects.vercel.app
# This server's public address. OPay sends payment notifications here. On Render you can leave it out (RENDER_EXTERNAL_URL is automatic).
BACKEND_URL=https://gbaanjo-api.onrender.com
ACTIVE_CITIES=Lagos               # live cities. Later: Lagos,Abuja

# ---- OPay (payments) ----  Get these from your OPay merchant dashboard.
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_ENV=sandbox                  # "sandbox" = fake money for testing. Change to "live" only when you are ready for real money.

# ---- Email (Resend) ----
RESEND_API_KEY=
MAIL_FROM="GbaanJo <hello@gbaanjo.com>"   # must be an address on a domain you verified in Resend
ADMIN_ALERT_EMAIL=                # where "new seller application", "refund to process" and "bug reported" alerts go

# ---- Photos (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- First admin account (use once, then DELETE ADMIN_PASSWORD) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=                   # at least 12 characters

# ---- Test-only switches (leave OUT in production) ----
# SEED_DEMO=true                  # fake sellers and listings
# SKIP_EMAIL_VERIFICATION=true    # accounts need no email check
# ALLOW_SIMULATED_PAYMENTS=true   # lets the server run without OPay keys; orders count as paid instantly. NEVER with real customers.
