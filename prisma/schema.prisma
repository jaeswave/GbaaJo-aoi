// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  phone         String?
  businessName  String?
  role          String    @default("BUYER") // BUYER | SELLER | ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings      Listing[]
  orders        Order[]
  feedback      Feedback[]

  @@index([email])
}

// ─────────────────────────────────────────────
// Listing
// ─────────────────────────────────────────────
model Listing {
  id           String    @id @default(cuid())
  sellerId     String
  title        String
  description  String?
  price        Float
  quantity     Int       @default(0)
  address      String?
  area         String?
  city         String?
  pickupBy     DateTime?
  status       String    @default("ACTIVE") // ACTIVE | SOLD_OUT | EXPIRED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  seller       User      @relation(fields: [sellerId], references: [id])
  orders       Order[]

  @@index([sellerId])
  @@index([city])
}

// ─────────────────────────────────────────────
// Order
// ─────────────────────────────────────────────
model Order {
  id           String    @id @default(cuid())
  orderNo      String    @unique
  listingId    String
  buyerId      String
  quantity     Int
  totalPrice   Float
  buyerFee     Float
  amountPaid   Float
  platformFee  Float
  sellerAmount Float
  pickupCode   String
  paymentRef   String    @unique
  opayOrderNo  String?
  payUrl       String?
  paidAt       DateTime?
  paidOutAt    DateTime?
  status       String    @default("PENDING") // PENDING | PAID | CANCELLED | COMPLETED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  listing      Listing   @relation(fields: [listingId], references: [id])
  buyer        User      @relation(fields: [buyerId], references: [id])

  @@index([buyerId])
  @@index([listingId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Feedback
// ─────────────────────────────────────────────
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  category  String   @default("GENERAL")
  rating    Int?
  message   String
  name      String?
  email     String?
  page      String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
}

// ─────────────────────────────────────────────
// Waitlist
// ─────────────────────────────────────────────
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  city      String?
  createdAt DateTime @default(now())
}